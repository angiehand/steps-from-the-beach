{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steps-from-the-beach",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steps-from-the-beach-db",
      "database_id": "739b471a-d423-4baf-9fcb-11cf210e1bb1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "steps-from-the-beach-photos"
    }
  ]
}
