{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steps-from-the-beach",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steps-from-the-beach-db",
      // Fill this in after creating the D1 database in the Cloudflare dashboard
      // (Storage & databases → D1 → Create database). Copy its "Database ID".
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "steps-from-the-beach-photos"
    }
  ]
}
